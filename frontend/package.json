{
	"name": "elivate-wallet-frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.19.0",
	"engines": {
		"node": ">=24.0.0 <25"
	},
	"scripts": {
		"dev": "vite dev --host 127.0.0.1 --port 3000",
		"build": "vite build",
		"preview": "vite preview --host 127.0.0.1 --port 3000",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"gen": "wrangler types"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/lexend": "5.3.0",
		"@fontsource/ibm-plex-mono": "5.3.0",
		"@lucide/svelte": "1.52.0",
		"@supabase/ssr": "0.12.7",
		"@supabase/supabase-js": "2.117.3",
		"bits-ui": "2.19.5",
		"effect": "4.0.2"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.64.0",
		"@sveltejs/adapter-cloudflare": "8.0.0",
		"@sveltejs/kit": "3.0.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "^24.19.1",
		"eslint": "10.12.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.13.0",
		"prettier": "3.9.9",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.1",
		"vite": "8.3.3",
		"vitest": "5.0.3",
		"wrangler": "4.148.0"
	}
}
