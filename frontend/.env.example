# Copy to .env.local (ignored by Git) and fill in for local development.
# Local Supabase: run `supabase status` in backend/ and use the API URL and the
# publishable (anon) key it prints. Never put a secret or service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile (Blueprint 10). For local development use Cloudflare's
# documented always-pass test keys: site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA. Real keys live only as Worker secrets.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Cloudflare's test keys report the hostname example.com.
TURNSTILE_HOSTNAMES=example.com
