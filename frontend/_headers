# Cloudflare Workers static assets: headers for files served without the
# Worker (the prerendered app shell, static files). Server-rendered pages get
# their headers and nonce CSP from hooks.server.ts / the Kit config.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY

/app
  Cache-Control: no-cache
  X-Robots-Tag: noindex, nofollow

/app/*
  X-Robots-Tag: noindex, nofollow

# Slice 33: the link-preview image and the root icons.
/og.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/service-worker.js
  Cache-Control: no-cache

# Blueprint 20 B8: unhashed static images. One day fresh, then served stale
# for up to a week while revalidating (the files aren't fingerprinted).
/root/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/auth-bg/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Slice 21: email images, fetched by mail clients and image proxies. They
# rarely change (mail proxies keep their own copy anyway): 30 days fresh.
/email/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
