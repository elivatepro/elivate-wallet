// Cloudflare Workers config (decision 37). Deployed to app.elivatewallet.com
// (owner decision 2026-10-08), backed by the development Supabase project until
// the production project exists.
// SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY are Worker secrets (wrangler
// secret put), so they persist across deploys; no values live in Git.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "elivate-wallet-app",
	"compatibility_date": "2026-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Hostnames a Turnstile token may come from (public, not a secret).
	"vars": { "TURNSTILE_HOSTNAMES": "app.elivatewallet.com" },
	"observability": { "enabled": true },
	// Private profile photos (Blueprint 06 B4). R2 must be enabled on the
	// account and the bucket created before the next deploy.
	"r2_buckets": [
		{ "binding": "PHOTOS", "bucket_name": "elivate-wallet-dev-photos" },
		// Statements and reports (Blueprint 15): private; a lifecycle rule removes
		// files after 7 days (owner decision Q6).
		{ "binding": "EXPORTS", "bucket_name": "elivate-wallet-dev-exports" }
	],
	// Cloudflare Browser Rendering for PDF statements and reports (Blueprint 15,
	// owner decision Q2; Workers Paid).
	"browser": { "binding": "BROWSER" },
	"routes": [{ "pattern": "app.elivatewallet.com", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false
}
