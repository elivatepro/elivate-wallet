// Cloudflare Workers config (decision 37). Deployed to app.elivatewallet.com
// (owner decision 2026-10-08), backed by the development Supabase project until
// the production project exists.
// SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY are Worker secrets (wrangler
// secret put), so they persist across deploys; no values live in Git.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "elivate-wallet-app",
	"compatibility_date": "2026-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": { "enabled": true },
	"routes": [{ "pattern": "app.elivatewallet.com", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false
}
