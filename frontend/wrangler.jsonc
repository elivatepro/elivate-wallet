// Cloudflare Workers config (decision 37). Deployed to app.elivatewallet.com
// (owner decision 2026-10-08), backed by the development Supabase project until
// the production project exists.
// SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY are Worker secrets (wrangler
// secret put), so they persist across deploys; no values live in Git.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "elivate-wallet-app",
	"compatibility_date": "2026-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Hostnames a Turnstile token may come from (public, not a secret), and the
	// Web Push VAPID public key browsers subscribe with (Blueprint 42; public;
	// its private half is an Edge secret of the outbox worker).
	"vars": {
		"TURNSTILE_HOSTNAMES": "app.elivatewallet.com",
		"PUSH_VAPID_PUBLIC_KEY": "BF276oyTx68Ezo21UVN8hba6IYnJAzfYCxynWbqJ1BZyqGkoXFDsrtqdgQE7og8S-LDAfd2OKBqHeueOqrGAO_c"
	},
	"observability": { "enabled": true },
	// Blueprint 20 B1: Smart Placement runs the Worker near Supabase (eu-west-2)
	// instead of near the visitor; static assets are still served at the edge
	// before the Worker (run_worker_first stays false).
	"placement": { "mode": "smart" },
	// Private profile photos (Blueprint 06 B4). R2 must be enabled on the
	// account and the bucket created before the next deploy.
	"r2_buckets": [
		{ "binding": "PHOTOS", "bucket_name": "elivate-wallet-dev-photos" },
		// Statements and reports (Blueprint 15): private; a lifecycle rule removes
		// files after 7 days (owner decision Q6).
		{ "binding": "EXPORTS", "bucket_name": "elivate-wallet-dev-exports" },
		// Team Backup Vault archives (Blueprint 17): private, no lifecycle rule;
		// the database expires them after 90 days and the runner deletes them.
		{ "binding": "BACKUPS", "bucket_name": "elivate-wallet-dev-backups" }
	],
	// Cloudflare Browser Rendering for PDF statements and reports (Blueprint 15,
	// owner decision Q2; Workers Paid).
	"browser": { "binding": "BROWSER" },
	"routes": [{ "pattern": "app.elivatewallet.com", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false
}
