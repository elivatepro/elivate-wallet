# Server-only secrets for Edge Functions. Set real values with
# `supabase secrets set` or an ignored .env file; never commit them.

# 32 random bytes as 64 hex characters (openssl rand -hex 32).
PIN_HMAC_SECRET=
# Where the emailed PIN reset link lands (must be in auth redirect allowlist).
PIN_RESET_REDIRECT_URL=
# Comma-separated browser origins allowed to call the functions.
CORS_ORIGINS=
