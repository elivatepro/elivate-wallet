# Server-only secrets for Edge Functions. Set real values with
# `supabase secrets set` or an ignored .env file; never commit them.

# 32 random bytes as 64 hex characters (openssl rand -hex 32).
PIN_HMAC_SECRET=
# Where the emailed PIN reset link lands (must be in auth redirect allowlist).
PIN_RESET_REDIRECT_URL=
# Comma-separated browser origins allowed to call the functions.
CORS_ORIGINS=

# ── Invitations and email (Blueprint 03) ──
# 32 random bytes as 64 hex characters. Derives invitation link tokens; never
# stored in the database. Used by `invitations` and `outbox-worker`.
INVITATION_TOKEN_SECRET=
# App origin for join links and the Auth sign-in redirect (<origin>/join must
# be in the Auth redirect allowlist), e.g. https://app.elivatewallet.com
APP_ORIGIN=
# Cloudflare Email Sending REST API: account id plus an API token scoped to
# Email Sending only, separate from the Auth SMTP token; one per environment.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
# Sender (owner decision 4): noreply@elivatewallet.com in production;
# noreply@dev.elivatewallet.com in development once that subdomain is onboarded.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
# 32 random bytes as 64 hex characters. The same value goes into Vault as
# `outbox_worker_secret`; Vault `outbox_worker_url` holds
# https://<project-ref>.supabase.co/functions/v1/outbox-worker
OUTBOX_WORKER_SECRET=
