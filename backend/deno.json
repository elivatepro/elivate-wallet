{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "tasks": {
    "fmt:check": "deno fmt --check src tests supabase/functions",
    "lint": "deno lint src tests supabase/functions",
    "test": "deno test tests",
    "check": "deno task fmt:check && deno task lint && deno task typecheck && deno task test",
    "typecheck": "deno check supabase/functions/**/*.ts tests/**/*.ts"
  },
  "fmt": {
    "lineWidth": 100
  }
}
