{
  "lock": {
    "path": "deno.lock",
    "frozen": true
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "tasks": {
    "fmt": "deno fmt src tests supabase/functions",
    "fmt:check": "deno fmt --check src tests supabase/functions",
    "lint": "deno lint src tests supabase/functions",
    "typecheck": "deno check src/**/*.ts tests/**/*.ts supabase/functions/**/*.ts",
    "test": "deno test tests",
    "check": "deno task fmt:check && deno task lint && deno task typecheck && deno task test"
  }
}
