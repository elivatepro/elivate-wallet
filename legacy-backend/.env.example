# Server-only Supabase Edge Function secrets. Set values through secure secret
# management; never add provider keys to frontend configuration or Git.
NUBAN_API_KEY=
OPENAI_API_KEY=
# Explicit model with image/PDF input and strict Responses structured outputs.
OPENAI_RECEIPT_MODEL=
# Dedicated 32-byte random worker credential, represented as 64 hex characters.
# Ordinary user JWTs and publishable/service keys are not worker credentials.
PAYOUT_VERIFIER_SECRET=
